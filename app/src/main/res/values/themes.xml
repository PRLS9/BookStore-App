<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base: siempre claro, aunque el celular esté en modo oscuro -->
    <style name="Base.Theme.BookStore" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/comic_neue_regular</item>
        <item name="fontFamily">@font/comic_neue_regular</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.BookStore" parent="Base.Theme.BookStore" />

    <!-- Splash propio: al ser transparente, Android no muestra su pantalla de inicio.
         Así aparece directamente nuestro splash blanco (un solo splash). -->
    <style name="Theme.BookStore.SplashPropio" parent="Theme.BookStore">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Botón "← Regresar" con fondo blanco, visible sobre el fondo de la app -->
    <style name="BotonRegresar" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blanco_card</item>
        <item name="android:textColor">@color/azul_marino</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/azul_marino</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>