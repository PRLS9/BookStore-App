<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/blanco_card">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLetraMiLibro"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:textColor="@color/blanco_card"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_cover_placeholder"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTituloMiLibro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/comic_neue_bold"
                    android:textColor="@color/texto_oscuro"/>

                <TextView
                    android:id="@+id/tvAutorMiLibro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/texto_oscuro"/>

                <TextView
                    android:id="@+id/tvInfoMiLibro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="#555555"/>

                <!-- Etiquetas: tipo de oferta y estado -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvTipoMiLibro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_card"
                        android:background="@drawable/bg_cover_placeholder"/>

                    <TextView
                        android:id="@+id/tvEstadoMiLibro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_card"
                        android:background="@drawable/bg_cover_placeholder"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Nota cuando el libro está prestado -->
        <TextView
            android:id="@+id/tvNotaMiLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="📖 Está prestado. Podrás editarlo o eliminarlo cuando lo devuelvan."
            android:textSize="13sp"
            android:textColor="#555555"/>

        <!-- Acción principal: marcar vendido / volver a publicar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrincipalMiLibro"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/blanco_card"
            android:backgroundTint="#2E8B57"
            app:cornerRadius="24dp"/>

        <!-- Editar y Eliminar -->
        <LinearLayout
            android:id="@+id/llAccionesMiLibro"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarMiLibro"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="✏️ Editar"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="@color/azul_marino"
                app:strokeColor="@color/azul_marino"
                app:cornerRadius="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarMiLibro"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🗑️ Eliminar"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#D64550"
                app:strokeColor="#D64550"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>