<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizLogros"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fondo">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresarLogros"
        style="@style/BotonRegresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:text="← Regresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTituloLogros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🏆 Mis logros"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/comic_neue_bold"
        android:textColor="@color/texto_oscuro"
        app:layout_constraintTop_toBottomOf="@id/btnRegresarLogros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloLogros"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- NIVEL Y PUNTOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_gradiente_logros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvEmojiNivel"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:gravity="center"
                            android:textSize="32sp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="#33FFFFFF"/>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvNombreNivel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#E6FFFFFF"/>

                            <TextView
                                android:id="@+id/tvPuntos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 pts"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/comic_neue_bold"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoNivel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        app:indicatorColor="#FFD166"
                        app:trackColor="#33FFFFFF"/>

                    <TextView
                        android:id="@+id/tvSiguienteNivel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnComoGanar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="¿Cómo gano puntos?  ›"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TU IMPACTO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2E8B57"
                app:cardBackgroundColor="#E8F5EE">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="💚"
                        android:textSize="30sp"/>

                    <TextView
                        android:id="@+id/tvImpacto"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/comic_neue_bold"
                        android:textColor="@color/texto_oscuro"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PESTAÑAS -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoLogros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPestanaInsignias"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏅 Insignias"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/azul_marino"
                    app:strokeColor="@color/azul_marino"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPestanaRanking"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏆 Ranking"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="@color/azul_marino"
                    app:strokeColor="@color/azul_marino"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- INSIGNIAS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInsignias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>

            <!-- RANKING -->
            <LinearLayout
                android:id="@+id/llRanking"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <!-- Podio -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/blanco_card">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:paddingTop="16dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- 2.º lugar -->
                        <LinearLayout
                            android:id="@+id/colPodio2"
                            android:orientation="vertical"
                            android:gravity="center_horizontal|bottom"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥈"
                                android:textSize="24sp"/>

                            <TextView
                                android:id="@+id/tvInicial2"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_circulo"
                                android:backgroundTint="#8C86B8"/>

                            <TextView
                                android:id="@+id/tvNombrePodio2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/texto_oscuro"/>

                            <FrameLayout
                                android:id="@+id/barra2"
                                android:layout_width="72dp"
                                android:layout_height="80dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_cover_placeholder"
                                android:backgroundTint="#B8B3D9">

                                <TextView
                                    android:id="@+id/tvPuntosPodio2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>
                            </FrameLayout>
                        </LinearLayout>

                        <!-- 1.er lugar -->
                        <LinearLayout
                            android:id="@+id/colPodio1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal|bottom"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥇"
                                android:textSize="30sp"/>

                            <TextView
                                android:id="@+id/tvInicial1"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_circulo"
                                android:backgroundTint="#D9A62E"/>

                            <TextView
                                android:id="@+id/tvNombrePodio1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/texto_oscuro"/>

                            <FrameLayout
                                android:id="@+id/barra1"
                                android:layout_width="80dp"
                                android:layout_height="110dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_cover_placeholder"
                                android:backgroundTint="#F2C14E">

                                <TextView
                                    android:id="@+id/tvPuntosPodio1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>
                            </FrameLayout>
                        </LinearLayout>

                        <!-- 3.er lugar -->
                        <LinearLayout
                            android:id="@+id/colPodio3"
                            android:orientation="vertical"
                            android:gravity="center_horizontal|bottom"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥉"
                                android:textSize="22sp"/>

                            <TextView
                                android:id="@+id/tvInicial3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_circulo"
                                android:backgroundTint="#C0845A"/>

                            <TextView
                                android:id="@+id/tvNombrePodio3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/texto_oscuro"/>

                            <FrameLayout
                                android:id="@+id/barra3"
                                android:layout_width="72dp"
                                android:layout_height="60dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_cover_placeholder"
                                android:backgroundTint="#D8A07A">

                                <TextView
                                    android:id="@+id/tvPuntosPodio3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvMiPuesto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/azul_marino"
                    android:background="@drawable/bg_cover_placeholder"
                    android:backgroundTint="@color/blanco_card"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRanking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>