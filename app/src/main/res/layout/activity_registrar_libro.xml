<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fondo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Grupo centrado -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="56dp"
                android:paddingBottom="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/logoRegistrarLibro"
                    android:layout_width="140dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/logo_bookstore"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Tarjeta -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/blanco_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/logoRegistrarLibro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrar un libro"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/comic_neue_bold"
                            android:textColor="@color/texto_oscuro"
                            android:layout_marginBottom="20dp"/>

                        <!-- Título -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTitulo"
                                android:hint="Título del libro"
                                android:textColor="@color/texto_oscuro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Autor -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAutor"
                                android:hint="Autor"
                                android:textColor="@color/texto_oscuro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Género -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilGenero"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:endIconMode="dropdown_menu">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvGeneroRegistro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Género"
                                android:inputType="none"
                                android:minHeight="48dp"
                                android:textColor="@color/texto_oscuro"
                                tools:ignore="SpeakableTextPresentCheck"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Curso -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCurso"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:endIconMode="dropdown_menu">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actvCursoRegistro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Curso"
                                android:inputType="none"
                                android:minHeight="48dp"
                                android:textColor="@color/texto_oscuro"
                                tools:ignore="SpeakableTextPresentCheck"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Tipo de oferta -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Qué quieres hacer con este libro?"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/comic_neue_bold"
                            android:textColor="@color/texto_oscuro"/>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupTipoOferta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="12dp"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedChip="@id/chipPrestamo">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPrestamo"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📖 Préstamo"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipIntercambio"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔄 Intercambio"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipVenta"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 Venta"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDonacion"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎁 Donación"/>
                        </com.google.android.material.chip.ChipGroup>

                        <!-- Precio (solo en Venta) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrecio"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone"
                            app:prefixText="S/ "
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrecio"
                                android:hint="Precio"
                                android:inputType="numberDecimal"
                                android:maxLength="5"
                                android:textColor="@color/texto_oscuro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- A cambio de (solo en Intercambio) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilIntercambio"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIntercambio"
                                android:hint="¿Qué libro te gustaría a cambio? (opcional)"
                                android:inputType="textCapSentences"
                                android:maxLength="80"
                                android:textColor="@color/texto_oscuro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Aviso de contacto (intercambio, venta o donación) -->
                        <TextView
                            android:id="@+id/tvAvisoContacto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone"
                            android:text="📱 Tu número de celular se mostrará a quien quiera contactarte por WhatsApp."
                            android:textSize="13sp"
                            android:textColor="#555555"/>

                        <!-- Sinopsis -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSinopsis"
                                android:hint="Sinopsis"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="3"
                                android:gravity="top|start"
                                android:maxLength="500"
                                android:textColor="@color/texto_oscuro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Botón Guardar -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGuardarLibro"
                            android:text="Guardar libro"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/blanco_card"
                            app:cornerRadius="24dp"
                            android:backgroundTint="@color/azul_marino"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón Regresar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresar"
        style="@style/BotonRegresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:text="← Regresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>