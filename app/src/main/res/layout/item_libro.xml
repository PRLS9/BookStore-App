<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/blanco_card">

    <LinearLayout
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvCoverLetter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:textColor="@color/blanco_card"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_cover_placeholder"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/comic_neue_bold"
                android:textColor="@color/texto_oscuro"/>

            <TextView
                android:id="@+id/tvAutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/texto_oscuro"/>

            <TextView
                android:id="@+id/tvGeneroChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/morado_bookstore"
                android:layout_marginTop="2dp"/>

            <!-- Etiqueta del tipo de oferta -->
            <TextView
                android:id="@+id/tvTipoOferta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/blanco_card"
                android:background="@drawable/bg_cover_placeholder"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_derecha"
            android:contentDescription="Ver detalle"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>