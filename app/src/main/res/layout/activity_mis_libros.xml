<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fondo">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresarMisLibros"
        style="@style/BotonRegresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:text="← Regresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTituloMisLibros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mis libros"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/comic_neue_bold"
        android:textColor="@color/texto_oscuro"
        app:layout_constraintTop_toBottomOf="@id/btnRegresarMisLibros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contador -->
    <TextView
        android:id="@+id/tvContadorMisLibros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/azul_marino"
        android:background="@drawable/bg_cover_placeholder"
        android:backgroundTint="@color/blanco_card"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMisLibros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Pestañas -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoPestanasMisLibros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/tvContadorMisLibros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaPublicados"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Publicados"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/azul_marino"
            app:strokeColor="@color/azul_marino"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaSolicitudes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Solicitudes"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/azul_marino"
            app:strokeColor="@color/azul_marino"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaFinalizados"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Finalizados"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/azul_marino"
            app:strokeColor="@color/azul_marino"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMisLibros"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/grupoPestanasMisLibros"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mensaje cuando no hay libros -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVacioMisLibros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/blanco_card"
        app:layout_constraintTop_toBottomOf="@id/grupoPestanasMisLibros"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗂️"
                android:textSize="48sp"/>

            <TextView
                android:id="@+id/tvMensajeVacioMisLibros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/comic_neue_bold"
                android:textColor="@color/texto_oscuro"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrRegistrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Registrar un libro"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/blanco_card"
                android:backgroundTint="@color/azul_marino"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>