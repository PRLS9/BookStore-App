<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔 Notificaciones"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/comic_neue_bold"
        android:textColor="@color/azul_marino"/>

    <TextView
        android:id="@+id/tvSinAvisos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone"
        android:text="No tienes avisos pendientes 🎉\nTodos tus préstamos están al día."
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/texto_oscuro"/>

    <LinearLayout
        android:id="@+id/llListaAvisos"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerPrestamosAvisos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Ver mis préstamos"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/blanco_card"
        android:backgroundTint="@color/azul_marino"
        app:cornerRadius="24dp"/>
</LinearLayout>