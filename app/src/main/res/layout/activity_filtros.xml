<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fondo">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresarFiltros"
        style="@style/BotonRegresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:text="← Regresar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTituloFiltros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Filtros"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/comic_neue_bold"
        android:textColor="@color/texto_oscuro"
        app:layout_constraintTop_toBottomOf="@id/btnRegresarFiltros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloFiltros"
        app:layout_constraintBottom_toTopOf="@id/barraBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TÍTULO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Título"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/comic_neue_bold"
                        android:textColor="@color/texto_oscuro"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColorHint="#555555"
                        app:endIconMode="dropdown_menu"
                        app:boxStrokeColor="@color/azul_marino"
                        app:hintTextColor="@color/azul_marino">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Escribe o elige un título"
                            android:minHeight="48dp"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:textColor="@android:color/black"
                            tools:ignore="SpeakableTextPresentCheck"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AUTOR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Autor"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/comic_neue_bold"
                        android:textColor="@color/texto_oscuro"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColorHint="#555555"
                        app:endIconMode="dropdown_menu"
                        app:boxStrokeColor="@color/azul_marino"
                        app:hintTextColor="@color/azul_marino">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvAutor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Escribe o elige un autor"
                            android:minHeight="48dp"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:textColor="@android:color/black"
                            tools:ignore="SpeakableTextPresentCheck"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- CURSO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Curso"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/comic_neue_bold"
                        android:textColor="@color/texto_oscuro"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColorHint="#555555"
                        app:endIconMode="dropdown_menu"
                        app:boxStrokeColor="@color/azul_marino"
                        app:hintTextColor="@color/azul_marino">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvCurso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Escribe o elige un curso"
                            android:minHeight="48dp"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:textColor="@android:color/black"
                            tools:ignore="SpeakableTextPresentCheck"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- GÉNEROS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Géneros"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/comic_neue_bold"
                        android:textColor="@color/texto_oscuro"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColorHint="#555555"
                        app:endIconMode="dropdown_menu"
                        app:boxStrokeColor="@color/azul_marino"
                        app:hintTextColor="@color/azul_marino">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvGenero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Escribe o elige géneros"
                            android:minHeight="48dp"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:textColor="@android:color/black"
                            tools:ignore="SpeakableTextPresentCheck"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGeneros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIPO DE OFERTA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/headerTipo"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tipo de oferta"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/comic_neue_bold"
                                android:textColor="@color/texto_oscuro"/>

                            <TextView
                                android:id="@+id/tvResumenTipo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp"
                                android:textColor="@color/morado_bookstore"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivFlechaTipo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_derecha"
                            android:contentDescription="Desplegar"/>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/grupoTipo"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ORDENAR POR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/headerOrden"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ordenar por"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/comic_neue_bold"
                                android:textColor="@color/texto_oscuro"/>

                            <TextView
                                android:id="@+id/tvResumenOrden"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp"
                                android:textColor="@color/morado_bookstore"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivFlechaOrden"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_derecha"
                            android:contentDescription="Desplegar"/>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/grupoOrden"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DISPONIBILIDAD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/blanco_card">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/headerDisponibilidad"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disponibilidad"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/comic_neue_bold"
                                android:textColor="@color/texto_oscuro"/>

                            <TextView
                                android:id="@+id/tvResumenDisponibilidad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp"
                                android:textColor="@color/morado_bookstore"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivFlechaDisponibilidad"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_derecha"
                            android:contentDescription="Desplegar"/>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/grupoDisponibilidad"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Botones Limpiar y Aplicar (sin barra blanca) -->
    <LinearLayout
        android:id="@+id/barraBotones"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiarFiltros"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Limpiar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/azul_marino"
            app:backgroundTint="@color/blanco_card"
            app:strokeColor="@color/azul_marino"
            app:strokeWidth="2dp"
            app:cornerRadius="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAplicarFiltros"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Aplicar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/blanco_card"
            android:backgroundTint="@color/azul_marino"
            app:cornerRadius="24dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>