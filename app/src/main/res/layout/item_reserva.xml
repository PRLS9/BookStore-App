<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/blanco_card">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLetraReserva"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:textColor="@color/blanco_card"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_cover_placeholder"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTituloReserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/comic_neue_bold"
                    android:textColor="@color/texto_oscuro"/>

                <TextView
                    android:id="@+id/tvAutorReserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/texto_oscuro"/>

                <TextView
                    android:id="@+id/tvEstadoReserva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/blanco_card"
                    android:background="@drawable/bg_cover_placeholder"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetalleReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="#555555"/>

        <!-- Barra de tiempo (solo cuando es tu turno) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresoTurno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:max="100"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp"
            app:indicatorColor="#2E8B57"
            app:trackColor="#E3F2E9"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrAlLibro"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/blanco_card"
                android:backgroundTint="@color/azul_marino"
                app:cornerRadius="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarReserva"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Cancelar"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#D64550"
                app:strokeColor="#D64550"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>